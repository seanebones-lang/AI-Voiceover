/node_modules
/.pnp
.pnp.js

# testing
/coverage
/test-results
/playwright-report
/blob-report
/.playwright

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
.railway.env

# SECURITY: Never commit these files
KEYS_AND_DEPLOY.txt
*.key
*.secret
*secrets*
*credentials*
deploy.sh
.railway/config.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# models (large files, downloaded at build)
/models/piper/*.onnx
/models/xtts/**/*
!/models/.gitkeep

# uploads
/uploads/*
!/uploads/.gitkeep

# python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/

# workers build output
apps/workers/dist/

# local Vercel env (use Vercel dashboard / pull)
apps/web/.env.vercel

# runtime XTTS voice clone storage
services/xtts/cloned_voices/

# IDE
.idea/
.vscode/
*.swp
*.swo
