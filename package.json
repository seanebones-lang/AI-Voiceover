{
  "name": "ai-voiceover-monorepo",
  "version": "3.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ai-voiceover/web",
    "build": "npm run build -w @ai-voiceover/web && npm run build -w @ai-voiceover/workers",
    "start": "npm run start -w @ai-voiceover/web",
    "lint": "npm run lint -w @ai-voiceover/web",
    "lint:strict": "npm run lint:strict -w @ai-voiceover/web",
    "typecheck": "npm run typecheck -w @ai-voiceover/web",
    "typecheck:test": "npm run typecheck:test -w @ai-voiceover/web",
    "typecheck:packages": "npm run typecheck -w @ai-voiceover/contracts && npm run typecheck -w @ai-voiceover/db && npm run typecheck -w @ai-voiceover/auth && npm run typecheck -w @ai-voiceover/billing",
    "test": "npm run test -w @ai-voiceover/web",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:api": "playwright test e2e/api-*.spec.ts",
    "e2e:full": "E2E_FULL=1 playwright test",
    "railway:sync": "node scripts/railway-sync-vars.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "eslint": "^9.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
