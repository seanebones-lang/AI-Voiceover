# Railway Configuration (Updated March 2026)
# Copy to .env or set in Railway Dashboard. Do NOT commit real values.
# Rotate any credentials that may have been exposed in version control.

# Railway CLI / API (get from https://railway.app/account/tokens)
RAILWAY_TOKEN=<your-railway-token>
RAILWAY_PROJECT_ID=<your-project-id>
RAILWAY_ENVIRONMENT_ID=<your-environment-id>

# Application Configuration
NODE_ENV=production
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=<generate-random-secret>
NEXTAUTH_URL=https://your-app.railway.app

# Service URLs (Railway). Use XTTS_URL or legacy XTTS_SIDECAR_URL (both supported).
XTTS_URL=http://xtts-service:8081
# XTTS_SIDECAR_URL=http://your-xtts-service.railway.internal:8081
# Optional: cap XTTS chunk size (chars per synthesis segment). Default: ~90% of each language's XTTS limit.
# XTTS_CLONE_CHUNK_CHARS=225

# Redis (Upstash) - optional for rate limiting; app works without it
UPSTASH_REDIS_REST_URL=<your-upstash-redis-url>
UPSTASH_REDIS_REST_TOKEN=<your-upstash-redis-token>

# Voice service (services/xtts) — all voices run on local models, no TTS API keys.
# auto | cpu | cuda
VOICE_DEVICE=auto
# Seconds of reference audio used for clone conditioning (higher = steadier identity)
# XTTS_GPT_COND_LEN=30
# XTTS_MAX_REF_LEN=30

# Voice Storage (persistent volume path on Railway)
VOICES_DIR=/app/cloned_voices

# Optional: lock down /api/metrics and /api/diagnostic/* (set to allow remote access)
# DIAGNOSTIC_SECRET=<generate-random-secret>
