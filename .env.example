# ==============================================
# AI Voice-Over Generator - Environment Variables
# ==============================================
# Canonical runtime: Next.js (next start). Service URLs for TTS/voice cloning and RAG.

# Server
PORT=3000
NODE_ENV=development

# NextAuth (when using auth)
NEXTAUTH_SECRET=<generate with: openssl rand -base64 32>
NEXTAUTH_URL=http://localhost:3000

# TTS / Voice services (optional overrides; defaults: localhost)
XTTS_URL=http://localhost:8081
TTS_V2_URL=http://localhost:8082
RAG_API_URL=http://localhost:8001

# Railway (when deploying)
# RAILWAY_TOKEN=... (set in dashboard or CI; do not commit)
# RAILWAY_PROJECT_ID=... RAILWAY_ENVIRONMENT_ID=... (optional)

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
ELEVENLABS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RATE_LIMIT_MAX=100
ALLOWED_ORIGINS=*
