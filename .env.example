# --- Core AI / voice (existing) ---
XAI_API_KEY=xai-...
ALLOWED_EMAILS=your-email@example.com

# Optional: lock /api/metrics and /api/diagnostic/* (see apps/web/lib/api-access.ts).
# DIAGNOSTIC_SECRET=

# Optional: Bearer or x-api-key on POST TTS/clone routes.
API_ROUTE_SECRET=change-this-secret

# --- Clerk (auth + organizations) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Webhook signing secret from Clerk dashboard → Webhooks → Signing secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# --- Stripe (subscriptions) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs for entitlement mapping (packages/billing)
# STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_TEAM=price_...

# --- Railway / data ---
DATABASE_URL=postgresql://user:***@host:5432/dbname
REDIS_URL=redis://default:***@host:6379

# --- Cookie domain (production optional) ---
# COOKIE_DOMAIN=

# --- XTTS Service ---
# XTTS_URL=http://xtts-service:8081
# XTTS_SIDECAR_URL=http://localhost:8081